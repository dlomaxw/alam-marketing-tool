# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- ALAM lease tool ---
# Secrets: never commit. Rotate anything that has ever been pasted into a chat.
.env
.env.*
!.env.example
db cred.txt
*.cred.txt

# Large source documents (60MB+). Uploaded through /sources at runtime instead.
source-documents/
storage/

# Test / local artifacts
/coverage
.drizzle-tmp

# Brand masters are large originals; the derived public/alam-logo*.png are committed.
brand/
scripts/.preview/
scripts/.parsed-sample.json

# Internal reference documents (handover spec, proposal decks). Marked
# "Internal use only" — kept local rather than pushed to a hosted repo.
/*.pdf
/*.docx
