# Copy to .env.local and fill in. Never commit the filled copy.

# --- Database (Postgres; Neon in this deployment) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Sessions --- generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Object storage (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=alam-lease-assets

# --- AI generation --- provider: gemini | stub ('stub' generates offline, for tests)
AI_PROVIDER=stub
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# --- Email delivery --- provider: console | resend | gmail | smtp
EMAIL_PROVIDER=console
# Resend: a domain must be verified before sending to anyone but the account owner.
RESEND_API_KEY=
# Signing secret from the Resend webhook endpoint (whsec_...).
RESEND_WEBHOOK_SECRET=
# Gmail API. Create an OAuth client in Google Cloud Console, then run
# "npm run gmail:authorize" to obtain the refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_FROM_NAME=ALAM Business Center
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Safety controls (spec section 14) ---
GLOBAL_SEND_ENABLED=false
TEST_SEND_ALLOWLIST=
DAILY_SEND_LIMIT=25

NEXT_PUBLIC_APP_URL=http://localhost:3000

# auto = R2 when configured, else local filesystem
STORAGE_DRIVER=auto
LOCAL_STORAGE_DIR=storage
